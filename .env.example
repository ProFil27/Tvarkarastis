# Copy to .env and fill in. .env is NOT committed (see .gitignore, N-22).
DB_HOST=db
DB_PORT=5432
DB_NAME=tvarkarastis
DB_USER=tvarkarastis_user
DB_PASSWORD=CHANGE_ME

AI_PROVIDER=gemini

GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.5-flash

CLAUDE_API_KEY=CHANGE_ME
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Google Calendar (leave empty to disable). The redirect URI must be registered in the Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/calendar/callback
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Semester start dates (MM-DD, comma separated) used for upload reminders
SEMESTER_START_DATES=09-01,02-01

SECRET_KEY=CHANGE_ME_RANDOM_STRING
FLASK_DEBUG=true
